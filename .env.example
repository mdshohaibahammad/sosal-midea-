# Server environment variables
PORT=5000

# MySQL Database (XAMPP default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=social_autoposter

JWT_SECRET=your_strong_random_secret_key_here
CORS_ORIGIN=http://localhost:5173
BASE_URL=http://localhost:5000
NODE_ENV=development

# Redis (optional - will fallback to local timer if offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Social OAuth Client IDs (replace with real values)
FACEBOOK_CLIENT_ID=your_facebook_client_id
INSTAGRAM_CLIENT_ID=your_instagram_client_id
TIKTOK_CLIENT_KEY=your_tiktok_client_key
YOUTUBE_CLIENT_ID=your_youtube_client_id

FACEBOOK_SCOPE=email,public_profile
INSTAGRAM_SCOPE=user_profile,user_media
TIKTOK_SCOPE=user.info.basic,video.list
YOUTUBE_SCOPE=https://www.googleapis.com/auth/youtube.upload

# Client environment variables
VITE_API_URL=/api